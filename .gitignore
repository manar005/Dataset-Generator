!output/seed_preparation_report.json
!output/pilot/
output/pilot/**
!output/pilot/.gitkeep
!output/pilot/quality_report.json
!output/pilot/pilot_selection.json
!output/full/
output/full/**
!output/full/.gitkeep
!output/full/quality_report.json

# Local seed datasets (keep the folder, ignore corpus files)
data/seeds/*
!data/seeds/.gitkeep

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

